{
  "name": "docs-mdx",
  "private": true,
  "scripts": {
    "dev": "node ./scripts/generateLlmTxt/index.mjs && next dev --port 3005",
    "build": "cross-env NODE_ENV=production NODE_OPTIONS=--max_old_space_size=8192 next build --webpack && node ./scripts/generateLlmTxt/index.mjs --export",
    "build:clean": "rimraf .next export out && pnpm build",
    "start": "serve ./out -l 3005",
    "serve": "serve ./out -l 3005",
    "check-types": "tsc --noEmit",
    "test": "vitest run",
    "docs-infra": "docs-infra",
    "validate": "pnpm build && pnpm link-check",
    "generate-llms": "node ./scripts/generateLlmTxt/index.mjs",
    "link-check": "node ./scripts/reportBrokenLinks.mts"
  },
  "dependencies": {
    "@base-ui/react": "1.9.0",
    "@base-ui/utils": "0.5.0",
    "@mdx-js/loader": "^3.1.1",
    "@mdx-js/react": "^3.1.1",
    "@mui/internal-docs-infra": "0.13.1-canary.7",
    "@next/mdx": "^16.3.6",
    "@orama/orama": "3.1.18",
    "@orama/stemmers": "3.1.18",
    "@stefanprobst/rehype-extract-toc": "^3.0.0",
    "@types/mdx": "^2.0.14",
    "clipboard-copy": "^4.0.1",
    "clsx": "^2.1.1",
    "es-toolkit": "^1.52.0",
    "estree-util-value-to-estree": "^3.5.0",
    "globby": "^16.2.4",
    "hast": "^1.0.0",
    "hast-util-heading-rank": "^3.0.0",
    "hast-util-to-string": "^3.0.1",
    "lucide-react": "^1.48.0",
    "lz-string": "^1.5.0",
    "next": "16.3.6",
    "postcss": "^8.5.28",
    "postcss-custom-media": "^12.0.2",
    "postcss-import": "^17.0.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-error-boundary": "6.1.6",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "remark-typography": "0.8.9",
    "scroll-into-view-if-needed": "3.1.0",
    "server-only": "^0.0.1",
    "unist-util-visit-parents": "^6.0.2"
  },
  "devDependencies": {
    "@mdx-js/mdx": "3.1.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/gtag.js": "0.0.20",
    "@types/hast": "3.0.5",
    "@types/node": "22.20.4",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@types/unist": "3.0.3",
    "cross-env": "10.1.0",
    "mdast-util-mdx-jsx": "3.2.0",
    "prettier": "3.9.9",
    "remark-stringify": "11.0.0",
    "rimraf": "6.1.3",
    "serve": "14.2.6",
    "tailwindcss": "4.3.3",
    "typescript": "~6.0.2",
    "unified": "11.0.5",
    "unist-util-visit": "5.1.0",
    "vitest": "^4.1.11",
    "tsx": "^4.23.15",
    "jsdom": "27.4.0",
    "stylelint": "17.15.0",
    "remark-mdx": "3.1.1",
    "postcss-value-parser": "4.2.0"
  },
  "version": "0.1.0",
  "description": "A compact MDX documentation template with search, live demos and API reference",
  "license": "MIT",
  "exports": {
    "./*": "./*"
  }
}
