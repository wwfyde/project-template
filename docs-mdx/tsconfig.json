{
  "include": [
    "src",
    "types.d.ts",
    "next-env.d.ts",
    "next.config.mjs",
    ".next/types/**/*.ts",
    "export/types/**/*.ts",
    ".next/dev/types/**/*.ts"
  ],
  "compilerOptions": {
    "allowJs": true,
    "isolatedModules": true,
    "noEmit": true,
    "noUnusedLocals": false,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "types": ["react"],
    "incremental": true,
    "composite": false,
    "module": "esnext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "docs-mdx/*": ["./*"]
    },
    "strictNullChecks": true,
    "jsx": "react-jsx",
    "target": "es2022",
    "lib": ["es2022", "dom", "dom.iterable"],
    "strict": true,
    "forceConsistentCasingInFileNames": true
  },
  "exclude": ["node_modules", "src/**/*.test.*"]
}
