# Copy to deploy/.env locally, or use deploy/init-env.sh on a server.
COMPOSE_PROJECT_NAME=project-template-test
APP_ENV=prod
HTTP_BIND=127.0.0.1
HTTP_PORT=18080
POSTGRES_USER=app
POSTGRES_DB=app
POSTGRES_PASSWORD=replace-with-a-random-password
REDIS_PASSWORD=replace-with-another-random-password

# Send traces/metrics/logs to your existing Alloy OTLP/HTTP receiver.
# This file is passed to the API by Compose; no image rebuild is needed.
OTEL_ENABLED=false
OTEL_SERVICE_NAME=project-template-api
OTEL_SERVICE_NAMESPACE=project-template
OTEL_DEPLOYMENT_ENVIRONMENT=test
OTEL_EXPORTER_OTLP_ENDPOINT=http://collector.internal.example.com:4318
OTEL_LOGS_ENABLED=true
OTEL_LOGS_LEVEL=INFO
# OTEL_EXPORTER_OTLP_LOGS_ENDPOINT=http://collector.internal.example.com:4318/v1/logs
# Switch to otlp after enabling both OTEL_ENABLED/OTEL_LOGS_ENABLED and validating
# Loki ingestion; Alloy must also apply the matching Docker exclusion rule.
API_LOGS_SOURCE=docker
OTEL_TRACES_SAMPLER_ARG=1.0
OTEL_METRIC_EXPORT_INTERVAL=60000
REDIS_OTEL_ENABLED=true
REDIS_OTEL_REDIS_ENABLED=true
# Optional model/storage settings; no credentials are baked into the images.
# PROVIDERS='{"openai":{"base_url":"https://api.openai.com/v1","api_key":"..."}}'
# OSS='{"bucket_name":"...","region":"...","access_key_id":"...","access_key_secret":"..."}'
