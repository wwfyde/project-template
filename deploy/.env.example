# Copy to deploy/.env locally, or use deploy/init-env.sh on a server.
COMPOSE_PROJECT_NAME=project-template-test
APP_ENV=prod
HTTP_BIND=127.0.0.1
HTTP_PORT=18080
POSTGRES_USER=app
POSTGRES_DB=app
POSTGRES_PASSWORD=replace-with-a-random-password
REDIS_PASSWORD=replace-with-another-random-password
# Optional model/storage settings; no credentials are baked into the images.
# PROVIDERS='{"openai":{"base_url":"https://api.openai.com/v1","api_key":"..."}}'
# OSS='{"bucket_name":"...","region":"...","access_key_id":"...","access_key_secret":"..."}'
