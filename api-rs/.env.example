## API 监听端口；命令行 --port 优先。兼容旧 API_PORT。
APP_PORT=8000

## 单下划线只展开一层，字段名中的下划线保留。
# POSTGRES_POOL_SIZE=30
# APP_API_KEY=replace-with-a-random-api-key
# APP_JWT_SECRET=replace-with-a-random-jwt-secret
# APP_ACCESS_TOKEN_EXPIRE_DAYS=30

REDIS_HOST="127.0.0.1"
REDIS_PORT=6379
REDIS_PASSWORD=""
REDIS_DB=0

## 嵌套供应商使用 JSON；也支持 PROVIDERS__OPENAI__MODEL 等双下划线形式。
# PROVIDERS_OPENAI='{"base_url":"https://api.openai.com/v1","api_key":"replace-with-your-key","model":"your-model"}'
