APP_ENV="dev"
APP_REQUEST_TIMEOUT="300"

# https://github.com/redis/fastapi-redis-sdk/blob/main/docs/guide/configuration.md
# REDIS_URL=redis://127.0.0.1:6379/0
REDIS_HOST="127.0.0.1"
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=""
REDIS_CLUSTER=false
# Sentinel (instead of REDIS_URL / REDIS_HOST / REDIS_PORT)
#REDIS_SENTINEL=true
#REDIS_SENTINEL_NODES=sentinel1:26379,sentinel2:26379,sentinel3:26379
#REDIS_SENTINEL_MASTER_NAME=mymaster
REDIS_MAX_CONNECTIONS=50
REDIS_SOCKET_TIMEOUT=5.0
REDIS_SOCKET_CONNECT_TIMEOUT=2.0
REDIS_PREFIX="api"
REDIS_DEFAULT_TTL=300
# Telemetry (OpenTelemetry)
REDIS_OTEL_ENABLED=true
REDIS_OTEL_REDIS_ENABLED=true