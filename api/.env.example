APP_ENV="dev"
APP_REQUEST_TIMEOUT="300"

# https://github.com/redis/fastapi-redis-sdk/blob/main/docs/guide/configuration.md
# REDIS_URL=redis://127.0.0.1:6379/0
REDIS_HOST="127.0.0.1"
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=""
REDIS_CLUSTER=false
# Sentinel (instead of REDIS_URL / REDIS_HOST / REDIS_PORT)
#REDIS_SENTINEL=true
#REDIS_SENTINEL_NODES=sentinel1:26379,sentinel2:26379,sentinel3:26379
#REDIS_SENTINEL_MASTER_NAME=mymaster
REDIS_MAX_CONNECTIONS=50
REDIS_SOCKET_TIMEOUT=5.0
REDIS_SOCKET_CONNECT_TIMEOUT=2.0
REDIS_PREFIX="api"
REDIS_DEFAULT_TTL=300
# Telemetry (OpenTelemetry)
OTEL_ENABLED=false
OTEL_SERVICE_NAME=project-template-api
OTEL_SERVICE_NAMESPACE=project-template
OTEL_DEPLOYMENT_ENVIRONMENT=local
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
OTEL_EXPORTER_OTLP_ENDPOINT=http://collector.internal.example.com:4318
OTEL_LOGS_ENABLED=true
OTEL_LOGS_LEVEL=INFO
# Optional full signal URL; otherwise /v1/logs is appended to the base endpoint.
# OTEL_EXPORTER_OTLP_LOGS_ENDPOINT=http://collector.internal.example.com:4318/v1/logs
OTEL_TRACES_SAMPLER=parentbased_traceidratio
OTEL_TRACES_SAMPLER_ARG=1.0
OTEL_METRIC_EXPORT_INTERVAL=60000
# Optional authentication; percent-encode commas and equals inside values.
# OTEL_EXPORTER_OTLP_HEADERS=Authorization=Bearer%20replace-me
# OTEL_SDK_DISABLED=true
# OTEL_FASTAPI_ENABLED=false
# OTEL_POSTGRES_ENABLED=false
REDIS_OTEL_ENABLED=true
REDIS_OTEL_REDIS_ENABLED=true
